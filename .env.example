NODE_ENV="development"
NGROK_AUTH="false"
PORT="3000"
DEFAULT_MPI_IMAGE="terminal-web:latest"
K8S_NAMESPACE="terminal-web"
SESSION_SECRET="chave-secreta"
MONGO_DB_URI="uri-banco-mongoDB"
LTI_ENCRYPTION_KEY="chave-lti-secreta"
LTI_PLATFORM_URL="https://moodle.instituicao.edu"
LTI_PLATFORM_NAME="Moodle"
LTI_CLIENT_ID="12345"
LTI_AUTH_ENDPOINT="https://moodle.instituicao.edu/auth.php"
LTI_TOKEN_ENDPOINT="https://moodle.instituicao.edu/token.php"
LTI_KEYSET_ENDPOINT="https://moodle.instituicao.edu/certs.php"
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
BURST_ENCRYPTION_KEY="sua-chave-criptografia-aes-256-gcm-32-bytes"
CLUSTER_CONGESTION_THRESHOLD="80"
# Opcional: nós locais elegíveis.
# Deixe em branco (ou com todas) para agendar livremente em todo o laboratório (ubuntu00 a ubuntu11).
# Para benchmarks homogêneos de alta performance (Core i7), restrinja a: "ubuntu10,ubuntu11"
LOCAL_CLUSTER_NODES="ubuntu10,ubuntu11,ubuntu00,ubuntu03,ubuntu05,ubuntu06,ubuntu07,ubuntu08,ubuntu09"
